{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["planner/**/*.ts", "sample-bot/**/*.ts", "judge/**/*.ts", "worker/**/*.ts", "web/**/*.ts", "report/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "out"]
}
