# Local dev only — never commit real keys. Copy to .env (gitignored).
PORT=8080
# Judge routing: prefer-local (default) | prefer-gemma | local-only | gemma-only
JUDGE_MODE=prefer-local
# Gemma on Cloud Run L4 (Ollama). Leave empty for offline mode.
JUDGE_URL=
JUDGE_MODEL=gemma3:4b
JUDGE_TIMEOUT_MS=120000
# Gemini fallback: Developer API key, or Vertex (GOOGLE_GENAI_USE_VERTEXAI=true + GCP_PROJECT + GOOGLE_ACCESS_TOKEN).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Live-test opt-in (costs a GPU wake): HELPLINECHECK_LIVE=1 GCP_PROJECT=... npm run test:live
HELPLINECHECK_LIVE=
GCP_PROJECT=
GCP_LOCATION=us-central1
